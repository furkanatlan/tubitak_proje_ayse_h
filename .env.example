# Bu dosyayı ".env" adıyla kopyalayıp değiştirebilirsiniz (zorunlu değil, varsayılanlar aşağıdaki gibidir).
# Port başka bir programla çakışıyorsa sadece buradaki sayıyı değiştirin.

DB_PORT=15432
BACKEND_PORT=18080
FRONTEND_PORT=15173
PGADMIN_PORT=15050
OSRM_PORT=15000

# OSRM verisini hazırladıktan sonra bu satırın başındaki # işaretini kaldırın;
# böylece "docker compose up -d" OSRM'yi de otomatik başlatır:
# COMPOSE_PROFILES=osrm

# Yerel OSRM yerine (bilgisayar 8 GB RAM'in altındaysa) herkese açık demo sunucusu kullanılabilir.
# Sadece geliştirme içindir, yoğun kullanımda engellenebilir:
# OSRM_URL=https://router.project-osrm.org

# Farklı bölge haritası (örn. daha küçük bir dosya) kullanmak için:
# OSM_PBF_URL=https://download.geofabrik.de/europe/turkey-latest.osm.pbf
